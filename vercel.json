{
  "crons": [
    {
      "path": "/api/send-reminder-emails",
      "schedule": "0 13 * * *"
    },
    {
      "path": "/api/send-marketing",
      "schedule": "0 14 * * *"
    },
    {
      "path": "/api/send-inactive-clients",
      "schedule": "0 13 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/encuesta/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/cancelar/(.*)",
      "destination": "/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}